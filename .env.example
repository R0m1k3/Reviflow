# Copiez ce fichier en .env et remplacez les valeurs.

# Secret de signature des JWT (obligatoire, >= 32 caractères) : openssl rand -hex 32
SECRET_KEY=change-me

# Mot de passe PostgreSQL (obligatoire).
# Installation existante : la base a été initialisée avec "reviflow" ; gardez cette
# valeur ou changez d'abord le mot de passe dans la base :
#   docker compose exec db psql -U reviflow -c "ALTER USER reviflow PASSWORD 'nouveau';"
POSTGRES_PASSWORD=change-me

# Clé OpenRouter globale (optionnelle)
OPENROUTER_API_KEY=

# Inscription publique : true (défaut) ou false
ALLOW_REGISTRATION=true

# Requêtes IA par jour et par famille avec la clé globale (0 = illimité)
GLOBAL_API_KEY_DAILY_QUOTA=30
